{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["bunx", "--bun", "@playwright/mcp@latest"],
        "enabled": true
      },
      "shadcn": {
        "type": "local",
        "command": ["bunx", "--bun", "shadcn@latest", "mcp"],
        "enabled": true
      }
    }
  }
}
